# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Real environment variables always win over this file: it only fills in
# variables the shell (or the deployment platform) has not already set.
#
# The analyst runs behind a deterministic verifier and either provider works.
# Set ONE key, or set both and name the one you mean in RECON_LLM_PROVIDER --
# with two keys and no choice recorded, a run refuses to guess rather than
# silently picking one.

# --- Gemini ---
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted instead, if you already have that one exported.

# --- Anthropic ---
# ANTHROPIC_API_KEY=

# anthropic | gemini. Optional when only one key above is set.
RECON_LLM_PROVIDER=gemini

# The Gemini model id. A DEFAULT, not a claim that it is current: override it
# here if the id has moved on. A wrong or unavailable id fails with a message
# naming the id it tried and this variable.
#
# Left commented out on purpose, so a clone gets the built-in default,
# gemini-3.5-flash, which has a free tier. gemini-3.7-flash is one uncomment
# away and is priced in core/llm/analyst.py -- $0.75/$3.75 per 1M through
# 2026-12-31, then $1.50/$7.50 -- so a run on it reports a real cost.
# RECON_GEMINI_MODEL=gemini-3.7-flash

# --- security (Phase 4) -------------------------------------------------------
#
# EVERY variable below is optional, and leaving them all unset is a supported
# configuration -- it is the demo/local default: no login, one implicit org,
# exactly the behaviour this API had before authentication existed.

# disabled | enabled. Unset means disabled.
# RECON_AUTH=enabled

# The HMAC key session cookies are signed with. REQUIRED when RECON_AUTH is
# enabled; the API refuses to start a session without it rather than generating
# one per process (a generated key signs sessions the next restart rejects).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# RECON_SECRET_KEY=

# The seeded user table: email|org_id|verifier, comma-separated. This is not a
# user-management product -- adding a user is a deployment action. Mint a
# verifier with:
#   python -c "from api.auth import password_hash; print(password_hash('...'))"
# RECON_USERS=alice@acme.test|org-acme|pbkdf2_sha256$240000$...$...

# Session lifetime in seconds. Default 43200 (12h).
# RECON_SESSION_TTL_SECONDS=43200

# base64 of 16/24/32 random bytes -- the AES-GCM key for the upload blob store.
# Unset means the store writes plaintext; see COMPLIANCE.md.
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# RECON_BLOB_KEY=

# --- paths and origins --------------------------------------------------------
#
# All four are optional and their defaults are what the demo runs on. They are
# listed here because a deployment needs every one of them and a reader should
# not have to grep api/settings.py to find out they exist.

# Comma-separated browser origins allowed to call the API. Default:
# http://localhost:3000, which is the console's dev origin. A wildcard is
# REFUSED rather than accepted quietly -- "it worked when I tested it" is how a
# wildcard survives into a deployment.
# RECON_CORS_ORIGINS=http://localhost:3000

# The SQLite file. Default out/recon.db.
# RECON_DB_PATH=out/recon.db

# Where `POST /api/datasets/generate` writes. Default out/datasets.
# RECON_DATASETS_DIR=out/datasets

# Where the content-addressed blob store keeps uploaded files. Default
# out/uploads. Under out/ like the database, so running the API leaves nothing
# untracked in the working tree. Encrypted only if RECON_BLOB_KEY is set.
# RECON_UPLOADS_DIR=out/uploads

# --- connectors (all optional) ------------------------------------------------
#
# A connector fetches a file the merchant would otherwise download and upload by
# hand. Every variable below is optional: unset means the connector reports
# itself unavailable, which is the DEFAULT and is not an error. A clone with
# none of these set starts, runs and passes its tests.
#
# A fetched file gets no shortcut for arriving over the wire -- it goes through
# the same sniff, the same quarantine and the same blob store as an upload.

# Pull the settlement recon report instead of downloading it by hand. These are
# the API-facing copy of the Razorpay key pair. SECRETS: never log them, never
# commit them, and no error message may echo one -- the refusals name these
# variables and never their values.
# RECON_RAZORPAY_KEY_ID=
# RECON_RAZORPAY_KEY_SECRET=

# The mailbox the merchant's bank already sends statements to. This is the only
# route that reaches a real Indian bank statement without an RBI-regulated FIU
# licence: there is no merchant-facing pull API, and the Account Aggregator
# sandbox serves mock data only.
#
# The mailbox is opened READ-ONLY and fetched with BODY.PEEK[], so nothing is
# marked read, moved or deleted.
#
# GMAIL: RECON_IMAP_PASSWORD must be an App Password
# (https://myaccount.google.com/apppasswords) with 2-Step Verification on.
# Google refuses an account password over IMAP. Host imap.gmail.com, port 993.
#
# RECON_IMAP_PASSWORD is a SECRET. Never log it, never commit it; every refusal
# in api/ and core/connectors/ names this variable and never its value.
# RECON_IMAP_HOST=imap.gmail.com
# RECON_IMAP_PORT=993
# RECON_IMAP_USER=
# RECON_IMAP_PASSWORD=

# Comma-separated senders to search. REQUIRED for a sync once the mailbox is
# configured: an unfiltered IMAP search is every message in the window, which
# is a mailbox dump rather than a reconciliation input, so the sync refuses
# without it.
# RECON_IMAP_SENDERS=alerts@slice.co,statements@hdfcbank.net

# Which folder to search. Default INBOX.
# RECON_IMAP_FOLDER=INBOX

# The password an Indian bank puts on a statement PDF. When set, an encrypted
# attachment is decrypted before the adapter layer sees it. When unset, an
# encrypted statement is still delivered and fails visibly in quarantine --
# a statement that silently disappears is worse than one that visibly fails.
# A SECRET, on the same terms as the two above.
# RECON_PDF_PASSWORD=

# A directory bank statements land in. The fallback with no counterparty: it
# covers the merchant whose statement arrives by courier or portal download, or
# from a bank whose mail this build cannot read yet. Unset means off; no
# directory is created by default.
# RECON_WATCH_DIR=
